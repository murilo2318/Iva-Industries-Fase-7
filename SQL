BEGIN;

-- -----------------------
-- 1) TIPOS / NORMALIZAÇÃO
-- -----------------------

CREATE TABLE IF NOT EXISTS machine_types (
    id_type SERIAL PRIMARY KEY,
    name VARCHAR(80) NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS sensor_types (
    id_sensor_type SERIAL PRIMARY KEY,
    name VARCHAR(80) NOT NULL UNIQUE,
    unit_default VARCHAR(20)
);

-- -----------------------
-- 2) MÁQUINAS E SENSORES
-- -----------------------

CREATE TABLE IF NOT EXISTS machines (
    id_machine SERIAL PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    type INTEGER NOT NULL,
    location VARCHAR(150),
    installed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(20) DEFAULT 'ativa',
    CHECK (status IN ('ativa','manutenção','parada')),
    CONSTRAINT fk_machine_type FOREIGN KEY (type) REFERENCES machine_types (id_type) ON DELETE RESTRICT
);

CREATE TABLE IF NOT EXISTS sensors (
    id_sensor SERIAL PRIMARY KEY,
    id_machine INTEGER NOT NULL,
    sensor_type INTEGER NOT NULL,
    label VARCHAR(120),
    unit VARCHAR(20),
    min_value DOUBLE PRECISION,
    max_value DOUBLE PRECISION,
    installed_at TIMESTAMP,
    active BOOLEAN DEFAULT TRUE,
    CONSTRAINT fk_sensor_machine FOREIGN KEY (id_machine) REFERENCES machines (id_machine) ON DELETE CASCADE,
    CONSTRAINT fk_sensor_type FOREIGN KEY (sensor_type) REFERENCES sensor_types (id_sensor_type) ON DELETE RESTRICT
);

-- -----------------------
-- 3) LEITURAS / PREDIÇÕES / MANUTENÇÃO / LOGS
-- -----------------------

CREATE TABLE IF NOT EXISTS readings (
    id_reading BIGSERIAL PRIMARY KEY,
    id_sensor INTEGER NOT NULL,
    value DOUBLE PRECISION NOT NULL,
    timestamp TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    raw_payload JSONB,
    CONSTRAINT fk_reading_sensor FOREIGN KEY (id_sensor) REFERENCES sensors (id_sensor) ON DELETE CASCADE,
    CHECK (value BETWEEN -1000000 AND 1000000)
);

CREATE TABLE IF NOT EXISTS predictions (
    id_prediction BIGSERIAL PRIMARY KEY,
    id_sensor INTEGER,
    timestamp TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    model_name VARCHAR(100),
    risk_score DOUBLE PRECISION CHECK (risk_score >= 0 AND risk_score <= 1),
    anomaly BOOLEAN,
    recommendation TEXT,
    input_payload JSONB,
    CONSTRAINT fk_prediction_sensor FOREIGN KEY (id_sensor) REFERENCES sensors (id_sensor) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS maintenance (
    id_maintenance BIGSERIAL PRIMARY KEY,
    id_machine INTEGER NOT NULL,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    severity VARCHAR(20),
    description TEXT,
    status VARCHAR(20) DEFAULT 'aberto',
    scheduled_for TIMESTAMP,
    closed_at TIMESTAMP,
    CONSTRAINT fk_maintenance_machine FOREIGN KEY (id_machine) REFERENCES machines (id_machine) ON DELETE CASCADE,
    CHECK (severity IN ('baixa','media','alta')),
    CHECK (status IN ('aberto','em andamento','concluido'))
);

CREATE TABLE IF NOT EXISTS system_logs (
    id_log BIGSERIAL PRIMARY KEY,
    timestamp TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    level VARCHAR(10) CHECK (level IN ('INFO','WARNING','ERROR')),
    component VARCHAR(80),
    message TEXT
);

-- -----------------------
-- 4) ÍNDICES IMPORTANTES
-- -----------------------

CREATE INDEX IF NOT EXISTS idx_readings_sensor_ts ON readings (id_sensor, timestamp DESC);
CREATE INDEX IF NOT EXISTS idx_predictions_sensor_ts ON predictions (id_sensor, timestamp DESC);
CREATE INDEX IF NOT EXISTS idx_maintenance_machine_created ON maintenance (id_machine, created_at DESC);
CREATE INDEX IF NOT EXISTS idx_sensors_machine ON sensors (id_machine);

